{
  "expo": {
    "name": "Prilleven",
    "slug": "prilleven-mobile-app",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "owner": "prilleven",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "be.prilleven.mobileapp",
      "buildNumber": "66",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Laat je HapjesHeld een foto nemen van ingrediënten of een etiket om een antwoord te krijgen.",
        "NSPhotoLibraryUsageDescription": "Kies een foto uit je galerij om die naar HapjesHeld te sturen voor een antwoord over kindervoeding."
      }
    },
    "android": {
      "package": "be.prilleven.mobileapp",
      "versionCode": 72,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "996391c7-00d0-4d2e-8113-fa3f9b79e0a9"
      }
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-web-browser"
    ]
  }
}
